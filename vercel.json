{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.{ts,js}": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/exercises/exercise/:id", "destination": "/api/exercises/:id" },
    { "source": "/api/exercises/bodyPart/:bodyPart", "destination": "/api/exercises?bodyPart=:bodyPart" },
    { "source": "/api/exercises/target/:target", "destination": "/api/exercises?target=:target" },
    { "source": "/api/exercises/equipment/:equipment", "destination": "/api/exercises?equipment=:equipment" },
    { "source": "/api/exercises/name/:name", "destination": "/api/exercises?name=:name" },
    { "source": "/api/exercises/bodyPartList", "destination": "/api/facets?type=body_parts" },
    { "source": "/api/exercises/targetList", "destination": "/api/facets?type=targets" },
    { "source": "/api/exercises/equipmentList", "destination": "/api/facets?type=equipment" },
    { "source": "/api/exercises/classificationList", "destination": "/api/facets?type=classifications" },
    { "source": "/api/exercises/difficultyList", "destination": "/api/facets?type=difficulties" },
    { "source": "/api/exercises/bodyRegionList", "destination": "/api/facets?type=body_regions" }
  ],
  "headers": [
    {
      "source": "/(videos|images)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
